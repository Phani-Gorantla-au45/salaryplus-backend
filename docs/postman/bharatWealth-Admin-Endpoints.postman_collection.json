{
  "info": {
    "name": "bharatWealth-Admin-Endpoints",
    "_postman_id": "bw-admin-collection-v1",
    "description": "All BharatWealth admin endpoints. Set {{baseUrl}} and {{adminToken}} in your environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:3000" },
    { "key": "adminSecret", "value": "BSGghghgsjds-shwhagdjhsju" },
    { "key": "adminToken",  "value": "" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.token) pm.collectionVariables.set('adminToken', r.token);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/registration/admin/login", "host": ["{{baseUrl}}"], "path": ["api","registration","admin","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"secret\": \"{{adminSecret}}\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Email Broadcast",
      "item": [
        {
          "name": "Preview Email (Test Send)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/email/preview", "host": ["{{baseUrl}}"], "path": ["api","admin","email","preview"] },
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Test Email Subject\",\n  \"body\": \"<p>Hello <strong>Investor</strong>,</p><p>This is a test email from BharatWealth.</p>\",\n  \"testEmail\": \"phanigorantla531@gmail.com\"\n}" }
          }
        },
        {
          "name": "Send Campaign — All Users",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/email/send", "host": ["{{baseUrl}}"], "path": ["api","admin","email","send"] },
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Important Update from BharatWealth\",\n  \"body\": \"<p>Dear Investor,</p><p>We have an exciting update for you.</p><p>Your wealth journey continues!</p>\",\n  \"recipients\": \"all\"\n}" }
          }
        },
        {
          "name": "Send Campaign — Selected Users",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/email/send", "host": ["{{baseUrl}}"], "path": ["api","admin","email","send"] },
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Exclusive Update for You\",\n  \"body\": \"<p>Dear Investor,</p><p>This message is specifically for you.</p>\",\n  \"recipients\": [\"uniqueId1\", \"uniqueId2\"]\n}" }
          }
        },
        {
          "name": "List Campaigns",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/email/campaigns?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api","admin","email","campaigns"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }, { "key": "includeTests", "value": "true", "disabled": true }] }
          }
        },
        {
          "name": "Get Campaign Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/email/campaigns/:id", "host": ["{{baseUrl}}"], "path": ["api","admin","email","campaigns",":id"],
              "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "List Emailable Users (Recipient Picker)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/email/users?search=", "host": ["{{baseUrl}}"], "path": ["api","admin","email","users"],
              "query": [{ "key": "search", "value": "", "description": "optional — filter by name, email or phone" }] }
          }
        }
      ]
    },

